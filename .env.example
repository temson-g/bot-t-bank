# Скопируй этот файл в .env и вставь СВОИ значения:
#   cp .env.example .env
#
# ============================================================
# T-INVEST API (нужен ТОЛЬКО для живого бота bot.py)
# Получить: приложение Т-Банк -> Т-Инвестиции -> настройки -> «Торговый API»
# НИКОМУ не показывай этот токен (это доступ к счёту = карта + ПИН).
T_INVEST_TOKEN=t.ваш_токен_сюда
# ============================================================

# DRY_RUN=1 -> бот только пишет в лог/Telegram, что бы сделал (безопасно)
# DRY_RUN=0 -> бот ставит РЕАЛЬНЫЕ ордера (только когда готов!)
DRY_RUN=1

# ============================================================
# TELEGRAM-ЛОГИРОВАНИЕ (опционально, работает и без счёта)
# 1) @BotFather -> /newbot -> получишь токен бота:
TELEGRAM_BOT_TOKEN=
# 2) Напиши своему боту любое сообщение, открой
#    https://api.telegram.org/bot<ТОКЕН>/getUpdates -> найди "chat":{"id": ...}:
TELEGRAM_CHAT_ID=
# ============================================================
